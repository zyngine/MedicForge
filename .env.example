# =============================================================================
# MedicForge environment variables
#
# Copy to .env.local for local development. Anything prefixed NEXT_PUBLIC_ is
# inlined into the browser bundle — never put a secret behind that prefix.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Canonical app URL -------------------------------------------------------
# Three separate variables are read across the codebase and they must agree.
# Use the www host: the middleware 301-redirects the bare domain to www, and a
# redirect can drop the hash fragment that carries Supabase auth tokens.
#   NEXT_PUBLIC_APP_URL   LMS invites, clinical/preceptor emails, /auth/callback
#   NEXT_PUBLIC_BASE_URL  CE emails and the Square webhook notification URL
#                         (this one is part of the webhook HMAC — if it does not
#                         match what Square is configured to call, every webhook
#                         fails signature verification)
#   NEXT_PUBLIC_SITE_URL  CE committee member setup links
NEXT_PUBLIC_APP_URL=https://www.medicforge.net
NEXT_PUBLIC_BASE_URL=https://www.medicforge.net
NEXT_PUBLIC_SITE_URL=https://www.medicforge.net

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@medicforge.net
CE_FROM_EMAIL=ce@medicforge.net
CE_ADMIN_EMAIL=admin@medicforge.net

# --- Square (CE payments) ----------------------------------------------------
# SQUARE_ENVIRONMENT (server) and NEXT_PUBLIC_SQUARE_ENVIRONMENT (browser SDK)
# are read separately and must be set to the same value, or the browser
# tokenizes against one environment while the server charges the other.
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_SUBSCRIPTION_PLAN_VARIATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Web push notifications --------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Bunny Stream (video hosting) --------------------------------------------
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=

# --- Plagiarism / AI detection (optional) ------------------------------------
GPTZERO_API_KEY=
ORIGINALITY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=

# --- Vercel domain management API (optional, used by /api/domains) -----------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
